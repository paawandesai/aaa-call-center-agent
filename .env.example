# Copy to .env and fill in locally. Never commit real values.
ANTHROPIC_AEA_API_KEY=placeholder
DATABASE_URL=postgres://user:password@host:5432/dbname
RAILWAY_TOKEN=placeholder
# Directory holding the unzipped partner dataset (kept outside the repo)
MERIDIAN_DATA_DIR=/mnt/project-files/data/meridian_dataset
# Where redacted transcripts are written (kept outside the repo)
MERIDIAN_REDACTED_DIR=/mnt/project-files/data/redacted
# Web app (web/). Also set SESSION_SECRET to 32+ random characters (openssl rand -hex 32).
INVITE_CODE=placeholder
STAFF_CODE=placeholder
DAILY_SPEND_CAP_USD=5
# Optional: pin the app clock inside the mock schedule (ends 2026-11-05), e.g. 2026-10-16T15:00:00Z
DEMO_NOW=
# Optional: model id for the agent (kept out of the repo's artifacts)
AGENT_MODEL=
