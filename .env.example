# Copy to .env and fill in locally. Never commit real values. Use absolute paths: the Python steps run from the repo
# root and npm from web/, so a relative path means different things to each (SEED_DIR is the exception, noted below);
# keep the partner's data outside the repo (it is gitignored under ./data either way).

# --- Secrets (required) ---
ANTHROPIC_AEA_API_KEY=placeholder
SESSION_SECRET=placeholder                               # 32+ random characters (openssl rand -hex 32); the app refuses to start without it
INVITE_CODE=placeholder                                  # caller access code
STAFF_CODE=placeholder                                   # staff pages; rotating either code signs its holders out
DATABASE_URL=postgres://user:password@host:5432/dbname   # or pglite:memory for local runs and the eval
RAILWAY_TOKEN=placeholder                                # deploy only

# --- Data pipeline (Python: discovery/redact.py, kb/ingest.py, eval/build_cases.py) ---
MERIDIAN_DATA_DIR=/abs/path/data/meridian_dataset # the unzipped partner dataset
MERIDIAN_REDACTED_DIR=/abs/path/data/redacted     # redacted transcripts
MERIDIAN_KB_OUT=/abs/path/data/kb                 # kb/ingest.py writes chunks.json here
MERIDIAN_EVAL_DIR=/abs/path/data/eval             # build_cases.py writes the eval cases here; npm run eval reads them

# --- Web app (web/) ---
KB_CHUNKS=/abs/path/data/kb/chunks.json           # chunks loaded by the eval, dev and smoke scripts
SEED_DIR=./.seed                                 # deploy seed (meridian_scheduling.sqlite, chunks.json); relative to web/, where npm runs
CLOCK_FLOOR=2026-10-19T14:00:00Z                 # the app clock never runs earlier than this (the mock schedule starts in October 2026)
# DEMO_NOW pins the clock exactly; the eval and tests set it themselves, so leave it out of .env.
DAILY_SPEND_CAP_USD=5
BOOKINGS_PER_SESSION=2
DEMO_BOOKINGS_PER_DAY=60                         # all visitors together, until the nightly reset
BOOKING_ATTEMPTS_PER_IP_DAY=10
# MODEL_CACHE_DIR=/abs/path/.models              # where the embedding model is stored; default web/.models
SEED_FORCE=0                                     # 1 reloads the seed tables on the next db:setup
KB_FORCE=0                                       # 1 re-embeds the KB on the next db:setup
DEMO_ACTIVITY=1                                  # 0 skips the sample staff-queue activity
RESET_ON_DEPLOY=0                                # 1 resets bookings on every deploy
CLIENT_IP_SOURCE=x_real_ip                       # header that carries the client address for per-IP limits: x_real_ip, xff_last or xff_first (check with /api/staff/ip-check)
AGENT_MODEL=claude-haiku-5-5                     # model for the agent
SAFETY_MODEL=claude-haiku-5-5                    # model for the per-message safety check
AGENT_EFFORT=low
AGENT_MAX_TOKENS=1024
RETRIEVAL_K=5
MIN_RETRIEVAL_SCORE=0.55

# --- Eval and browser checks (optional) ---
EVAL_NOTE=                                       # free text saved with a dev run's summary
# web/e2e/*.mjs (Playwright, run with node from web/ against a running app):
#   BASE=http://localhost:3100  CODE / STAFF = the invite and staff codes  SHOTS=<screenshot dir>  CHROME=<chromium path>
